{
  "name": "reviewcue",
  "version": "0.1.0",
  "description": "Local-first review packet builder for git diffs.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "reviewcue": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "docs",
    "fixtures",
    "scripts",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm run build && bash scripts/package-smoke.sh",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke",
    "prepack": "npm run build"
  },
  "keywords": [
    "code-review",
    "cli",
    "git",
    "diff",
    "local-first",
    "ai-review"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/reviewcue.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/reviewcue/issues"
  },
  "homepage": "https://github.com/rogerchappel/reviewcue#readme"
}
